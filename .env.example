# PriceWatch CA settings. setup.sh copies this to .env (mode 600) and fills in secrets.
# Every API key is optional; features turn on only when their key is present.

# ---- Deployment ----
PRICEWATCH_VERSION=0.7.0
# Host port (registered in dev-sop/ports.md)
PRICEWATCH_HOST_PORT=8086
# Host folder for the database, backups and .secret_key (a TrueNAS dataset path)
PRICEWATCH_DATA_PATH=./data
TZ=America/Toronto
PRICEWATCH_LOG_LEVEL=INFO

# ---- Access ----
# password = built-in login; none = rely on reverse proxy authentication
PRICEWATCH_AUTH_MODE=password
PRICEWATCH_ADMIN_USERNAME=admin
PRICEWATCH_ADMIN_PASSWORD=
# true when served over HTTPS (Cloudflare Tunnel / Nginx Proxy Manager with TLS)
PRICEWATCH_COOKIE_SECURE=false
# Optional; generated into data/.secret_key when empty
PRICEWATCH_SECRET_KEY=

# ---- Fetching ----
# Shown in the User-Agent so site owners can identify the tracker (a URL or note, not your email unless you want it)
PRICEWATCH_CONTACT=self-hosted
# Minimum seconds between requests to one domain, plus up to 30% random extra
PRICEWATCH_MIN_DOMAIN_INTERVAL=20
PRICEWATCH_DOMAIN_JITTER=0.3
PRICEWATCH_MAX_CONCURRENCY=4
# Check intervals (minutes), each with plus or minus 30% jitter
PRICEWATCH_DEFAULT_INTERVAL_MINUTES=360
PRICEWATCH_HOT_INTERVAL_MINUTES=120
PRICEWATCH_BLACKFRIDAY_INTERVAL_MINUTES=30
PRICEWATCH_BLACKFRIDAY_MAX_ITEMS=25
# Circuit breaker: pause a domain after this many blocked fetches in a row, for this many hours
PRICEWATCH_BREAKER_BLOCKS=3
PRICEWATCH_BREAKER_HOURS=6

# ---- Browser sidecar (Playwright) ----
PRICEWATCH_BROWSER_ENABLED=true
PRICEWATCH_BROWSER_TIMEOUT=30

# ---- Notifications (Apprise URLs, comma separated; also editable in Settings) ----
# Address your phone uses to reach PriceWatch (e.g. https://pricewatch.your-tailnet.ts.net); enables
# ntfy action buttons (Bought, Snooze 24h, Raise target). Leave empty to send plain notifications.
PRICEWATCH_PUBLIC_URL=
# e.g. ntfys://ntfy.sh/your-private-topic
PRICEWATCH_NOTIFY_URLS=

# ---- Optional search providers for discovery (off when empty) ----
# SerpApi Google Shopping: 250 free searches a month (serpapi.com)
SERPAPI_KEY=
# Bright Data SERP API (free tier, then about US$1.50 per 1,000 requests); zone must be a SERP API zone
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=serp_api1

# ---- Amazon.ca via Keepa (paid; no direct Amazon scraping). Empty = Amazon items are manual entry ----
KEEPA_API_KEY=

# ---- Optional changedetection.io bridge (use its watches as the fetch engine for chosen sources) ----
# e.g. http://changedetection:5000 (same Docker network) or http://192.168.2.15:8087
CHANGEDETECTION_URL=
CHANGEDETECTION_API_KEY=

# ---- Later phases (unused in v0.3) ----
# ANTHROPIC_API_KEY=
